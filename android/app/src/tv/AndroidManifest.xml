<?xml version="1.0" encoding="utf-8"?>
<!-- Kairos TV: stessa app di Kairos Pro ma più leggera.
     Niente registrazioni (servizio in primo piano, notifiche, sveglie) e niente multi-schermo:
     li togliamo dal manifest unito, così R8 elimina anche il loro codice dall'APK. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" tools:node="remove" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:node="remove" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <application>
        <activity android:name="com.kairos.player.MultiActivity" tools:node="remove" />
        <service android:name="com.kairos.player.RecService" tools:node="remove" />
    </application>
</manifest>
